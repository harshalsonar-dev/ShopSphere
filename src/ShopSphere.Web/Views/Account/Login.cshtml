@model ShopSphere.Application.Features.Auth.DTOs.LoginRequestDto
@{
    ViewData["Title"] = "Sign In";
    var returnUrl = ViewBag.ReturnUrl as string;
}

<div class="row justify-content-center py-4">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            <div class="text-center mb-4">
                <i class="bi bi-person-circle fs-1 text-primary"></i>
                <h3 class="fw-bold mt-2">Welcome Back</h3>
                <p class="text-muted small">Sign in with your ShopSphere account</p>
            </div>

            <div asp-validation-summary="All" class="text-danger small mb-3"></div>

            <form method="post" asp-action="Login" asp-route-returnUrl="@returnUrl">
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-muted">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-envelope text-muted"></i></span>
                        <input asp-for="Email" id="loginEmail" class="form-control" placeholder="name@example.com" required />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-semibold text-muted">Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-lock text-muted"></i></span>
                        <input asp-for="Password" id="loginPassword" type="password" class="form-control" placeholder="••••••••" required />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                </button>
            </form>

            <hr class="my-4 text-muted" />

            <div class="text-center">
                <p class="small text-muted mb-3">Quick Demo Auto-Fill (Click to populate):</p>
                <div class="d-flex justify-content-center gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="fillCredentials('admin@shopsphere.com', 'Admin@123')">
                        <i class="bi bi-shield-lock me-1"></i> Admin
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="fillCredentials('customer@shopsphere.com', 'Customer@123')">
                        <i class="bi bi-person me-1"></i> Customer
                    </button>
                </div>
            </div>

            <div class="text-center mt-4">
                <span class="small text-muted">Don't have an account? </span>
                <a asp-action="Register" class="small fw-semibold text-decoration-none">Create an account</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function fillCredentials(email, pwd) {
            document.getElementById('loginEmail').value = email;
            document.getElementById('loginPassword').value = pwd;
        }
    </script>
}
