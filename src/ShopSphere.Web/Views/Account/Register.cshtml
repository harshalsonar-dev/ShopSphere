@model ShopSphere.Application.Features.Auth.DTOs.RegisterRequestDto
@{
    ViewData["Title"] = "Create Account";
}

<div class="row justify-content-center py-4">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            <div class="text-center mb-4">
                <i class="bi bi-person-plus-fill fs-1 text-primary"></i>
                <h3 class="fw-bold mt-2">Join ShopSphere</h3>
                <p class="text-muted small">Create an account to start shopping or managing products</p>
            </div>

            <div asp-validation-summary="All" class="text-danger small mb-3"></div>

            <form method="post" asp-action="Register">
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-muted">Full Name</label>
                    <input asp-for="FullName" class="form-control" placeholder="John Doe" required />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-muted">Email Address</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="john@example.com" required />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-muted">Account Role</label>
                    <select asp-for="Role" class="form-select">
                        <option value="Customer">Customer (Shop & Order)</option>
                        <option value="Admin">Admin (Manage Products & Orders)</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-muted">Password</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" required />
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-semibold text-muted">Confirm Password</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="••••••••" required />
                </div>

                <button type="submit" class="btn btn-warning w-100 py-2 fw-semibold text-dark">
                    <i class="bi bi-person-check me-1"></i> Register Now
                </button>
            </form>

            <div class="text-center mt-4">
                <span class="small text-muted">Already have an account? </span>
                <a asp-action="Login" class="small fw-semibold text-decoration-none">Sign in here</a>
            </div>
        </div>
    </div>
</div>
