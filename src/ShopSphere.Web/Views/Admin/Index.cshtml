@model IReadOnlyList<ProductDto>
@{
    ViewData["Title"] = "Admin Management Portal";
    var totalOrders = ViewBag.TotalOrders as int? ?? 0;
    var totalRevenue = ViewBag.TotalRevenue as decimal? ?? 0m;
    var lowStockCount = ViewBag.LowStockCount as int? ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-speedometer2 text-primary me-2"></i>Admin Dashboard</h2>
        <p class="text-muted mb-0">Overview of inventory health, revenue, and product catalog management.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Orders" class="btn btn-outline-primary">
            <i class="bi bi-receipt me-1"></i> Manage Orders (@totalOrders)
        </a>
        <a asp-action="CreateProduct" class="btn btn-primary fw-semibold">
            <i class="bi bi-plus-circle-fill me-1"></i> Add New Product
        </a>
    </div>
</div>

<!-- Metrics Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            <div class="d-flex align-items-center">
                <div class="bg-primary-subtle text-primary rounded-4 p-3 me-3">
                    <i class="bi bi-box-seam fs-3"></i>
                </div>
                <div>
                    <span class="text-muted small fw-semibold">Total Catalog Products</span>
                    <h3 class="fw-bold mb-0">@Model.Count</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            <div class="d-flex align-items-center">
                <div class="bg-success-subtle text-success rounded-4 p-3 me-3">
                    <i class="bi bi-cash-stack fs-3"></i>
                </div>
                <div>
                    <span class="text-muted small fw-semibold">Total Platform Revenue</span>
                    <h3 class="fw-bold mb-0">$@totalRevenue.ToString("F2")</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            <div class="d-flex align-items-center">
                <div class="bg-warning-subtle text-warning rounded-4 p-3 me-3">
                    <i class="bi bi-exclamation-triangle fs-3"></i>
                </div>
                <div>
                    <span class="text-muted small fw-semibold">Low Stock Items (<10)</span>
                    <h3 class="fw-bold mb-0">@lowStockCount</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Products Inventory Table -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
    <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0">Product Inventory</h5>
        <span class="badge bg-secondary">@Model.Count total</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Product Name</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Stock Level</th>
                    <th>Date Added</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <span class="fw-bold text-dark">@product.Name</span>
                            <small class="text-muted d-block text-truncate" style="max-width: 320px;">@product.Description</small>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">@product.CategoryName</span>
                        </td>
                        <td class="fw-bold">$@product.Price.ToString("F2")</td>
                        <td>
                            @if (product.StockQuantity <= 5)
                            {
                                <span class="badge bg-danger rounded-pill px-3 py-1">Critical: @product.StockQuantity left</span>
                            }
                            else if (product.StockQuantity < 20)
                            {
                                <span class="badge bg-warning text-dark rounded-pill px-3 py-1">Low: @product.StockQuantity</span>
                            }
                            else
                            {
                                <span class="badge bg-success-subtle text-success rounded-pill px-3 py-1">Healthy (@product.StockQuantity)</span>
                            }
                        </td>
                        <td>@product.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td class="text-end pe-4">
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="EditProduct" asp-route-id="@product.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-pencil me-1"></i> Edit
                                </a>
                                <form method="post" asp-action="DeleteProduct" asp-route-id="@product.Id" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this product?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
