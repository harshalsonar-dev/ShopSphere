@model CartDto
@{
    ViewData["Title"] = "Your Shopping Cart";
}

<div class="row mb-4">
    <div class="col-12">
        <h2 class="fw-bold mb-1"><i class="bi bi-cart3 text-primary me-2"></i>Shopping Cart</h2>
        <p class="text-muted">Review your selected items before proceeding to checkout.</p>
    </div>
</div>

@if (Model.Items.Count == 0)
{
    <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
        <div class="py-5">
            <i class="bi bi-cart-x fs-1 text-muted"></i>
            <h4 class="mt-3 fw-bold">Your Cart is Empty</h4>
            <p class="text-muted">Explore our catalog and find premium tech products for your setup.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2 mt-2">
                <i class="bi bi-arrow-left me-1"></i> Start Shopping
            </a>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        <!-- Cart Items Table -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Product</th>
                                <th>Price</th>
                                <th style="width: 170px;">Quantity</th>
                                <th>Subtotal</th>
                                <th class="text-end pe-4">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary-subtle text-primary rounded-3 p-3 me-3">
                                                <i class="bi bi-box-seam fs-4"></i>
                                            </div>
                                            <div>
                                                <h6 class="mb-0 fw-semibold">@item.ProductName</h6>
                                                <small class="text-muted">SKU: PRD-@item.ProductId</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>$@item.UnitPrice.ToString("F2")</td>
                                    <td>
                                        <form method="post" asp-action="UpdateQuantity" class="d-flex align-items-center gap-1">
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <button type="submit" name="quantity" value="@(item.Quantity - 1)" class="btn btn-sm btn-outline-secondary px-2 py-1">
                                                <i class="bi bi-dash"></i>
                                            </button>
                                            <span class="px-2 fw-semibold">@item.Quantity</span>
                                            <button type="submit" name="quantity" value="@(item.Quantity + 1)" class="btn btn-sm btn-outline-secondary px-2 py-1">
                                                <i class="bi bi-plus"></i>
                                            </button>
                                        </form>
                                    </td>
                                    <td class="fw-bold text-dark">$@item.SubTotal.ToString("F2")</td>
                                    <td class="text-end pe-4">
                                        <form method="post" asp-action="Remove" class="d-inline">
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove item">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-footer bg-white p-3 d-flex justify-content-between align-items-center">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left me-1"></i> Continue Shopping
                    </a>
                    <form method="post" asp-action="Clear">
                        <button type="submit" class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-trash3 me-1"></i> Clear Cart
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Order Summary Card -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h5 class="fw-bold mb-4">Order Summary</h5>

                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Subtotal (@Model.TotalItems items)</span>
                    <span class="fw-semibold">$@Model.TotalAmount.ToString("F2")</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Standard Shipping</span>
                    <span class="text-success fw-semibold">FREE</span>
                </div>
                <div class="d-flex justify-content-between mb-3">
                    <span class="text-muted">Estimated Tax</span>
                    <span class="fw-semibold">$0.00</span>
                </div>

                <hr />

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <span class="fs-5 fw-bold">Total</span>
                    <span class="fs-4 fw-bold text-primary">$@Model.TotalAmount.ToString("F2")</span>
                </div>

                <a asp-controller="Orders" asp-action="Checkout" class="btn btn-warning w-100 py-3 fw-bold text-dark shadow-sm">
                    <i class="bi bi-shield-check me-1"></i> Proceed to Checkout
                </a>

                <div class="mt-3 text-center">
                    <small class="text-muted d-block">
                        <i class="bi bi-lock-fill text-success me-1"></i> Real-time inventory verified at checkout
                    </small>
                </div>
            </div>
        </div>
    </div>
}
