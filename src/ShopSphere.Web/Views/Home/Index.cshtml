@model PagedResult<ProductDto>
@{
    ViewData["Title"] = "Products Catalog";
    var categories = ViewBag.Categories as IReadOnlyList<CategoryDto> ?? new List<CategoryDto>();
    var selectedCategoryId = ViewBag.CategoryId as int?;
    var searchTerm = ViewBag.SearchTerm as string ?? "";
    var minPrice = ViewBag.MinPrice as decimal?;
    var maxPrice = ViewBag.MaxPrice as decimal?;
}

<div class="row mb-4">
    <div class="col-12">
        <div class="p-4 rounded-4 text-white shadow-sm" style="background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <h1 class="display-6 fw-bold mb-2">Discover High-Performance Tech</h1>
                    <p class="lead mb-0 text-white-50">Browse the latest hardware, monitors, audio gear, and peripherals with real-time stock updates.</p>
                </div>
                <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                    <span class="badge bg-light text-dark fs-6 px-3 py-2 shadow-sm">
                        <i class="bi bi-lightning-charge-fill text-warning me-1"></i> @Model.TotalCount Products Available
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Sidebar Filters -->
    <div class="col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top" style="top: 1.5rem; z-index: 10;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-funnel-fill text-primary me-2"></i>Filters</h5>
                <a asp-action="Index" class="btn btn-sm btn-link text-decoration-none text-muted p-0">Reset All</a>
            </div>

            <form method="get" asp-action="Index" id="filterForm">
                <!-- Search Term -->
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-muted">Search Products</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="searchTerm" value="@searchTerm" class="form-control border-start-0 ps-0" placeholder="e.g. 4K, Wireless..." />
                    </div>
                </div>

                <!-- Categories -->
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-muted">Category</label>
                    <select name="categoryId" class="form-select">
                        <option value="">All Categories</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.Id" selected="@(selectedCategoryId == cat.Id ? "selected" : null)">@cat.Name</option>
                        }
                    </select>
                </div>

                <!-- Price Range -->
                <div class="mb-4">
                    <label class="form-label small fw-semibold text-muted">Price Range ($)</label>
                    <div class="row g-2">
                        <div class="col-6">
                            <input type="number" step="0.01" name="minPrice" value="@minPrice" class="form-control" placeholder="Min" />
                        </div>
                        <div class="col-6">
                            <input type="number" step="0.01" name="maxPrice" value="@maxPrice" class="form-control" placeholder="Max" />
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 fw-semibold py-2">
                    <i class="bi bi-check2-circle me-1"></i> Apply Filters
                </button>
            </form>
        </div>
    </div>

    <!-- Product Grid -->
    <div class="col-lg-9">
        @if (Model.Items.Count == 0)
        {
            <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
                <div class="py-5">
                    <i class="bi bi-inbox fs-1 text-muted"></i>
                    <h4 class="mt-3 fw-bold">No Products Found</h4>
                    <p class="text-muted">No items match your active filter criteria. Try adjusting the search keywords or price bounds.</p>
                    <a asp-action="Index" class="btn btn-outline-primary px-4">View All Products</a>
                </div>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
                @foreach (var product in Model.Items)
                {
                    <div class="col">
                        <div class="card card-product h-100 border-0 shadow-sm bg-white">
                            <div class="card-body d-flex flex-column p-4">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1">
                                        @product.CategoryName
                                    </span>
                                    @if (product.StockQuantity > 0)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill badge-stock">
                                            In Stock (@product.StockQuantity)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill badge-stock">
                                            Out of Stock
                                        </span>
                                    }
                                </div>

                                <h5 class="card-title fw-bold text-dark mt-2 mb-2">@product.Name</h5>
                                <p class="card-text text-muted small flex-grow-1">@product.Description</p>

                                <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                                    <div>
                                        <span class="text-muted small d-block">Price</span>
                                        <h4 class="fw-bold text-dark mb-0">$@product.Price.ToString("F2")</h4>
                                    </div>
                                    <button onclick="quickAddToCart(@product.Id)" 
                                            class="btn btn-primary px-3 py-2 rounded-3 @(product.StockQuantity <= 0 ? "disabled" : "")"
                                            @(product.StockQuantity <= 0 ? "disabled" : "")>
                                        <i class="bi bi-cart-plus me-1"></i> Add
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <nav class="mt-5 d-flex justify-content-center">
                    <ul class="pagination shadow-sm">
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-pageIndex="@(Model.PageIndex - 1)"
                               asp-route-searchTerm="@searchTerm"
                               asp-route-categoryId="@selectedCategoryId"
                               asp-route-minPrice="@minPrice"
                               asp-route-maxPrice="@maxPrice">
                                <i class="bi bi-chevron-left"></i> Previous
                            </a>
                        </li>
                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.PageIndex ? "active" : "")">
                                <a class="page-link" asp-action="Index" 
                                   asp-route-pageIndex="@p"
                                   asp-route-searchTerm="@searchTerm"
                                   asp-route-categoryId="@selectedCategoryId"
                                   asp-route-minPrice="@minPrice"
                                   asp-route-maxPrice="@maxPrice">
                                    @p
                                </a>
                            </li>
                        }
                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-pageIndex="@(Model.PageIndex + 1)"
                               asp-route-searchTerm="@searchTerm"
                               asp-route-categoryId="@selectedCategoryId"
                               asp-route-minPrice="@minPrice"
                               asp-route-maxPrice="@maxPrice">
                                Next <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        }
    </div>
</div>
